{
  "_comment": "Motifs interdits dans le bundle frontend. Utilisés par vite.config.ts (build) et scripts/check-bundle-secrets.mjs (contrôle a posteriori).",
  "keyPatterns": [
    {
      "name": "Clé OpenAI",
      "regex": "(?<![A-Za-z0-9_-])sk-(?:proj-|svcacct-|admin-)?[A-Za-z0-9_-]{20,}"
    },
    {
      "name": "Clé Anthropic",
      "regex": "(?<![A-Za-z0-9_-])sk-ant-[A-Za-z0-9_-]{20,}"
    },
    {
      "name": "Clé OpenRouter",
      "regex": "(?<![A-Za-z0-9_-])sk-or-v1-[A-Za-z0-9]{20,}"
    },
    {
      "name": "Clé Groq",
      "regex": "(?<![A-Za-z0-9_-])gsk_[A-Za-z0-9]{20,}"
    },
    {
      "name": "Clé xAI",
      "regex": "(?<![A-Za-z0-9_-])xai-[A-Za-z0-9]{20,}"
    },
    {
      "name": "Clé Google (Gemini)",
      "regex": "(?<![A-Za-z0-9_-])AIza[0-9A-Za-z_-]{35}"
    },
    {
      "name": "Clé Pinecone",
      "regex": "(?<![A-Za-z0-9_-])pcsk_[A-Za-z0-9_]{20,}"
    },
    {
      "name": "Clé privée PEM",
      "regex": "-----BEGIN [A-Z ]*PRIVATE KEY-----"
    },
    {
      "name": "Chaîne MongoDB avec mot de passe",
      "regex": "mongodb(?:\\+srv)?://[^:/\\s\"']+:[^@\\s\"']+@"
    },
    {
      "name": "Chaîne PostgreSQL avec mot de passe",
      "regex": "postgres(?:ql)?://[^:/\\s\"']+:[^@\\s\"']+@"
    }
  ],
  "providerHosts": [
    "api.openai.com",
    "api.anthropic.com",
    "api.groq.com",
    "api.x.ai",
    "generativelanguage.googleapis.com",
    "openrouter.ai/api"
  ],
  "publicEnvAllowlist": [
    "VITE_SUPABASE_URL",
    "VITE_SUPABASE_ANON_KEY",
    "VITE_API_URL",
    "SUPABASE_URL",
    "SUPABASE_ANON_KEY",
    "FRONTEND_URL",
    "API_BASE_URL",
    "PINECONE_INDEX",
    "CLOUDINARY_CLOUD_NAME",
    "JWT_EXPIRES_IN",
    "NODE_ENV",
    "PORT"
  ]
}
