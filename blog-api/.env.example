# blog-api — variables d'environnement (NOMS UNIQUEMENT, aucune valeur réelle ici)
# Copier vers .env (non versionné) sur le serveur, chmod 600.

# ── Serveur ──────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
FRONTEND_URL=

# ── MongoDB (blog) ───────────────────────────────────────────
MONGODB_URI=

# ── JWT du blog ──────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Route d'amorçage POST /api/auth/admin : fermée par défaut.
# Mettre true uniquement le temps de créer le premier admin, puis revenir à false.
ADMIN_BOOTSTRAP_ENABLED=false
# 32 caractères minimum (la route reste fermée sinon)
ADMIN_SECRET=

# ── Administration du portfolio (Supabase Auth) ──────────────
# Utilisées par requireSupabaseAdmin (routes /api/agent/knowledge/*).
# URL du projet (https://<ref>.supabase.co) et clé publique « anon » : ce ne sont pas des secrets.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Uniquement pour les projets Supabase qui signent encore les jetons en HS256 (secret partagé).
# Facultatif : sans elle, la signature est validée par Supabase lui-même. SECRET si renseigné.
SUPABASE_JWT_SECRET=

# ── Base de connaissances de l'assistant (Pinecone) ──────────
PINECONE_API_KEY=
PINECONE_INDEX=
# Ajout / téléversement / suppression (admin + MFA). Fermé par défaut.
KNOWLEDGE_WRITE_ENABLED=false
# Facultatif : limites (requêtes / 15 min / IP et écritures / heure / admin)
# ADMIN_RATE_LIMIT_MAX=100
# KNOWLEDGE_WRITE_RATE_LIMIT_MAX=30

# ── IA : centre d'administration multi-IA ─────────────────
# Les clés des six fournisseurs sont saisies dans le dashboard et stockées dans Supabase
# Vault : AUCUNE clé de fournisseur dans ce fichier. Fournisseurs, modèles, affectations,
# quotas et budgets sont enregistrés dans Supabase.
#
# Connexion du rôle restreint ai_backend (aucun droit sur les tables, uniquement les
# fonctions ai_private.runtime_*). Pooler Supabase, mode session (port 5432) :
#   postgresql://ai_backend.<ref-projet>:<mot-de-passe>@<hôte-du-pooler>:5432/postgres
# Absente → toutes les fonctionnalités IA sont « momentanément indisponibles ». SECRET.
AI_DATABASE_URL=
# Certificat du projet (Dashboard Supabase → Database → SSL). TLS toujours vérifié hors
# boucle locale ; les paramètres sslmode de l'URL sont ignorés.
AI_DATABASE_CA_FILE=
# Sel HMAC des journaux d'usage et des empreintes de clés (32 caractères aléatoires ou plus). SECRET.
AI_LOG_HMAC_SECRET=
# Coupe-circuits prioritaires sur le dashboard : global, et liste de fonctionnalités désactivées
AI_ENABLED=true
AI_DISABLED_FEATURES=
# Facultatif — limites techniques :
# AI_RATE_LIMIT_PER_MINUTE=6            (remplace la limite par minute du dashboard)
# AI_ADMIN_WRITE_RATE_LIMIT_MAX=300     (écritures du centre IA par heure et par administrateur)

# ── Cloudinary (images du blog) ──────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# La compilation LaTeX (/api/cv/compile) est désactivée dans le code :
# aucune variable ne permet de la réactiver dans ce processus.
