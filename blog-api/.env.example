# blog-api — variables d'environnement (NOMS UNIQUEMENT, aucune valeur réelle ici)
# Copier vers .env (non versionné) sur le serveur, chmod 600.

# ── Serveur ──────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
FRONTEND_URL=

# ── MongoDB (blog) ───────────────────────────────────────────
MONGODB_URI=

# ── JWT du blog ──────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Route d'amorçage POST /api/auth/admin : fermée par défaut.
# Mettre true uniquement le temps de créer le premier admin, puis revenir à false.
ADMIN_BOOTSTRAP_ENABLED=false
# 32 caractères minimum (la route reste fermée sinon)
ADMIN_SECRET=

# ── Administration du portfolio (Supabase Auth) ──────────────
# Utilisées par requireSupabaseAdmin (routes /api/agent/knowledge/*).
# URL du projet (https://<ref>.supabase.co) et clé publique « anon » : ce ne sont pas des secrets.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Uniquement pour les projets Supabase qui signent encore les jetons en HS256 (secret partagé).
# Facultatif : sans elle, la signature est validée par Supabase lui-même. SECRET si renseigné.
SUPABASE_JWT_SECRET=

# ── Base de connaissances de l'assistant (Pinecone) ──────────
PINECONE_API_KEY=
PINECONE_INDEX=
# Ajout / téléversement / suppression (admin + MFA). Fermé par défaut.
KNOWLEDGE_WRITE_ENABLED=false
# Facultatif : limites (requêtes / 15 min / IP et écritures / heure / admin)
# ADMIN_RATE_LIMIT_MAX=100
# KNOWLEDGE_WRITE_RATE_LIMIT_MAX=30

# ── IA (Groq) ────────────────────────────────────────────────
# Routes historiques /api/agent/chat et /api/groq/* (assistant, InkSpace, NovaMind)
GROQ_API_KEY=

# ── Passerelle IA /api/ai (CV Generator, éditeur LaTeX) ──────
# Clé OpenAI CÔTÉ SERVEUR uniquement (jamais de variable VITE_*). SECRET.
# Absente → fonctions IA du CV et du LaTeX affichées « momentanément indisponibles ».
# Ne JAMAIS y mettre l'ancienne clé exposée dans le bundle : créer une nouvelle clé.
OPENAI_API_KEY=
# Fournisseurs déclarés pour la suite (adaptateurs en P1.A, gestion via Supabase Vault en P1.B) :
# XAI_API_KEY= GEMINI_API_KEY= OPENROUTER_API_KEY= ANTHROPIC_API_KEY=
# Sel HMAC des journaux d'usage (32 caractères aléatoires ou plus). SECRET.
AI_LOG_HMAC_SECRET=
# Coupe-circuits : global, et liste de fonctionnalités désactivées (ex. cv.import.ocr,latex.generate)
AI_ENABLED=true
AI_DISABLED_FEATURES=
# Affectations VALIDÉES : seules celles-ci s'exécutent (liste fonctionnalité=fournisseur:modèle).
# Changer de modèle remet la fonctionnalité à « non validée ». Contrôle gratuit : npm run ai:check-models
AI_VALIDATED_ASSIGNMENTS=
# Facultatif — affectation par fonctionnalité (sinon src/ai/config/initial-assignments.json) :
# AI_ASSIGNMENT_CV_GENERATE=fournisseur:modèle
# Facultatif — quotas parSujetParJour/globalParJour/concurrence, limites globales :
# AI_QUOTA_CV_GENERATE=3/150/3
# AI_MAX_CONCURRENCY=8
# AI_RATE_LIMIT_PER_MINUTE=6

# ── Cloudinary (images du blog) ──────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# La compilation LaTeX (/api/cv/compile) est désactivée dans le code :
# aucune variable ne permet de la réactiver dans ce processus.
