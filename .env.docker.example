# .env.docker — variables de docker compose (NOMS UNIQUEMENT, aucune valeur réelle ici)
# Copier vers .env.docker (non versionné) et compléter.

# ── API (voir blog-api/.env.example pour le détail) ──────────
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:8080
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_SECRET=
SUPABASE_URL=
SUPABASE_ANON_KEY=
PINECONE_API_KEY=
PINECONE_INDEX=
KNOWLEDGE_WRITE_ENABLED=false
AI_DATABASE_URL=
# Chemin DANS le conteneur (voir le montage commenté de docker-compose.yml)
AI_DATABASE_CA_FILE=
AI_LOG_HMAC_SECRET=
AI_ENABLED=true
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Build du frontend (publiques par nature) ─────────────────
VITE_API_URL=http://localhost:5000/api
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Profil dev : MongoDB local et son interface ──────────────
MONGO_USER=admin
MONGO_PASSWORD=
MONGO_UI_USER=admin
MONGO_UI_PASSWORD=
