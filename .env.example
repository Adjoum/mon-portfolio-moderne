# Frontend (Vite) — variables PUBLIQUES uniquement : tout VITE_* est intégré au bundle
# et lisible par n'importe quel visiteur. Aucune clé privée ici (le build échoue sinon).
# Les clés des fournisseurs IA vivent uniquement sur le serveur : voir blog-api/.env.example.

VITE_API_URL=http://localhost:5000/api
VITE_SUPABASE_URL=
# Clé « anon » publique de Supabase (protégée par la RLS) — jamais la clé service_role
VITE_SUPABASE_ANON_KEY=
