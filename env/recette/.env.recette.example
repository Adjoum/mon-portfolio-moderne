# Recette locale (npm run dev:recette) : seules variables lues par Vite dans ce mode.
# Copier en .env.recette.local (ignoré par Git) et compléter avec le projet Supabase de TEST.
# Jamais l'URL de production : Vite refuse de démarrer si elle est utilisée ici.
VITE_API_URL=http://localhost:5000/api
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
