# Recette locale : seules variables lues par Vite dans ce mode.
# .env.recette.local (ignoré par Git) est généré par scripts/recette.mjs, avec le Supabase local.
# Jamais l'URL de production : Vite refuse de démarrer si elle est utilisée ici.
VITE_API_URL=http://localhost:5000/api
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
